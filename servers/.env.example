# ─────────────────────────────────────────────────────────────────────────────
# CivicFlow Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values
# cp .env.example .env
#
# Required values are marked with [REQUIRED]
# Optional values have sensible defaults
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──
APP_NAME=civicflow
APP_ENV=development
LOG_LEVEL=DEBUG

# ── ClickHouse Database ──
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=civicflow
CLICKHOUSE_USER=civicflow
CLICKHOUSE_PASSWORD=change_me_in_production

# ── Redis Cache ──
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_ENABLED=true

# ── Laya Classifier ──
LAYA_CLASSIFIER_URL=http://localhost:8001
LAYA_CLASSIFIER_TIMEOUT=30
LAYA_CLASSIFIER_ENABLED=true

# ── Google Gemini (Legacy - optional, Laya is preferred) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── MinIO Object Storage ──
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=civic-media
MINIO_SECURE=false

# ── Kafka Event Streaming ──
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_COMPLAINTS=civic.complaints
KAFKA_CONSUMER_GROUP=civicflow-worker-group

# ─────────────────────────────────────────────────────────────────────────────
# Discord Integration
# ─────────────────────────────────────────────────────────────────────────────

# Discord Webhooks (per department)
# Get webhooks from: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_ROADS=
DISCORD_WEBHOOK_WATER=
DISCORD_WEBHOOK_ELECTRICITY=
DISCORD_WEBHOOK_SANITATION=
DISCORD_WEBHOOK_TRANSPORT=
DISCORD_WEBHOOK_HOUSING=
DISCORD_WEBHOOK_PLANNING=
DISCORD_WEBHOOK_FALLBACK=

# Discord Bot (for slash commands)
# Create app at: https://discord.com/developers/applications
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Telegram Bot Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Telegram Bot Token [REQUIRED for Telegram bot]
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot and follow the instructions
# 3. Copy the API token here
TELEGRAM_BOT_TOKEN=

# Telegram Webhook URL (for production)
# Format: https://your-domain.com/telegram/webhook
# Leave empty for polling mode (development)
TELEGRAM_WEBHOOK_URL=

# Telegram Webhook Secret (optional, for security)
# Generate a random string: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Enable/disable Telegram bot
TELEGRAM_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Groq API Configuration (for Telegram Bot LLM)
# ─────────────────────────────────────────────────────────────────────────────

# Groq API Key [REQUIRED for Telegram bot]
# 1. Go to https://console.groq.com/
# 2. Sign up or login
# 3. Create an API key from the dashboard
GROQ_API_KEY=

# Groq Model (chat models available in your account)
# Options: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
# Audio models: whisper-large-v3, whisper-large-v3-turbo
GROQ_MODEL=qwen/qwen3.8-27b

# Response temperature (0.0 - 2.0, lower = more focused)
GROQ_TEMPERATURE=0.7

# Max tokens per response
GROQ_MAX_TOKENS=1000

# ─────────────────────────────────────────────────────────────────────────────
# CivicFlow Backend API (for bot to connect to)
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL (for bot to submit complaints)
CIVICFLOW_API_URL=http://localhost:8000

# Optional API key for bot authentication
CIVICFLOW_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────────────

# Secret key for session encryption
# Generate: openssl rand -hex 32
SECRET_KEY=change_me_in_production_use_secure_random_string

# API key hash rounds (for bcrypt)
API_KEY_HASH_ROUNDS=12

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ─────────────────────────────────────────────────────────────────────────────
# Observability (OpenTelemetry)
# ─────────────────────────────────────────────────────────────────────────────

# OTLP endpoint for traces (e.g., http://localhost:4317)
OTLP_ENDPOINT=

# Enable/disable tracing
TRACING_ENABLED=false

# Trace sampling rate (0.0 - 1.0)
TRACING_SAMPLE_RATE=1.0

# ─────────────────────────────────────────────────────────────────────────────
# Bot Behavior (Telegram Bot)
# ─────────────────────────────────────────────────────────────────────────────

# Bot language (en, kn, hi)
BOT_LANGUAGE=en

# Max conversation history to remember
MAX_CONVERSATION_HISTORY=10

# Minimum keywords to trigger complaint submission
COMPLAINT_KEYWORDS_THRESHOLD=3
